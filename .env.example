# Keep real credentials in .env.local or your host's secret settings.
# Never prefix this key with NEXT_PUBLIC_.
BREVO_API_KEY=
# Use a sender address/domain verified in Brevo. It can be contact@ayyan.tech
# once you have verified that address/domain in your own account.
BREVO_SENDER_EMAIL=
CONTACT_TO_EMAIL=contact@ayyan.tech
# Set to the exact public origin when deploying, without a trailing path.
SITE_URL=http://localhost:3000
